<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:layoutDirection="locale" android:textDirection="locale">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp" android:paddingEnd="20dp" android:paddingBottom="32dp">
        <TextView style="@style/TextAppearance.Mood.Headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="@string/settings_title"/>
        <TextView style="@style/TextAppearance.Mood.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="start" android:text="@string/settings_subtitle"/>
        <TextView style="@style/TextAppearance.Mood.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="start" android:text="@string/settings_permissions_section"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardDndPermission" style="@style/Widget.Mood.ClickableCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_circle" android:contentDescription="@null" android:padding="12dp" android:src="@drawable/ic_dnd" app:tint="@color/mood_primary"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.Mood.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="@string/dont_disturb"/>
                    <TextView style="@style/TextAppearance.Mood.CardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="start" android:text="@string/dont_disturb_description"/>
                </LinearLayout>
                <TextView android:id="@+id/textDndStatus" style="@style/TextAppearance.Mood.PermissionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/permission_required"/>
                <View android:id="@+id/dotDndStatus" style="@style/Widget.Mood.PermissionDot" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardWriteSettingsPermission" style="@style/Widget.Mood.ClickableCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_circle" android:contentDescription="@null" android:padding="12dp" android:src="@drawable/ic_brightness" app:tint="@color/mood_primary"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.Mood.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="@string/system_settings_permission"/>
                    <TextView style="@style/TextAppearance.Mood.CardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="start" android:text="@string/system_settings_permission_description"/>
                </LinearLayout>
                <TextView android:id="@+id/textWriteSettingsStatus" style="@style/TextAppearance.Mood.PermissionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/permission_required"/>
                <View android:id="@+id/dotWriteSettingsStatus" style="@style/Widget.Mood.PermissionDot" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardNotificationPermission" style="@style/Widget.Mood.ClickableCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_circle" android:contentDescription="@null" android:padding="12dp" android:src="@drawable/ic_notification" app:tint="@color/mood_primary"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.Mood.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="@string/active_mode_notification"/>
                    <TextView style="@style/TextAppearance.Mood.CardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="start" android:text="@string/active_mode_notification_description"/>
                </LinearLayout>
                <TextView android:id="@+id/textNotificationStatus" style="@style/TextAppearance.Mood.PermissionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/permission_required"/>
                <View android:id="@+id/dotNotificationStatus" style="@style/Widget.Mood.PermissionDot" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/TextAppearance.Mood.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="start" android:text="@string/settings_personalization_section"/>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Mood.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_circle" android:contentDescription="@null" android:padding="12dp" android:src="@drawable/ic_theme" app:tint="@color/mood_primary"/>
                <TextView style="@style/TextAppearance.Mood.CardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:gravity="start" android:text="@string/app_appearance"/>
                <Spinner android:id="@+id/spinnerTheme" android:layout_width="140dp" android:layout_height="48dp" android:entries="@array/theme_labels"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Mood.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_circle" android:contentDescription="@null" android:padding="12dp" android:src="@drawable/ic_language" app:tint="@color/mood_primary"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.Mood.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="@string/app_language"/>
                    <TextView style="@style/TextAppearance.Mood.CardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="start" android:text="@string/app_language_description"/>
                </LinearLayout>
                <Spinner android:id="@+id/spinnerLanguage" android:layout_width="128dp" android:layout_height="48dp" android:entries="@array/language_labels"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/TextAppearance.Mood.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="start" android:text="@string/settings_automation_section"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardSchedules" style="@style/Widget.Mood.ClickableCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_circle" android:contentDescription="@null" android:padding="12dp" android:src="@drawable/ic_schedule" app:tint="@color/mood_primary"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.Mood.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="@string/schedules_title"/>
                    <TextView style="@style/TextAppearance.Mood.CardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="start" android:text="@string/settings_schedules_body"/>
                </LinearLayout>
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:rotation="180" android:src="@drawable/ic_chevron" app:tint="@color/mood_text_secondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Mood.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_circle" android:contentDescription="@null" android:padding="12dp" android:src="@drawable/ic_tile" app:tint="@color/mood_primary"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.Mood.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="@string/quick_settings_tile"/>
                    <TextView style="@style/TextAppearance.Mood.CardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="start" android:text="@string/quick_settings_tile_description"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonAddTile" style="@style/Widget.Mood.TonalButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/add"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Mood.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_circle" android:contentDescription="@null" android:padding="12dp" android:src="@drawable/ic_widget" app:tint="@color/mood_primary"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.Mood.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="@string/home_screen_widget"/>
                    <TextView style="@style/TextAppearance.Mood.CardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="start" android:text="@string/home_screen_widget_description"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonAddWidget" style="@style/Widget.Mood.TonalButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/add"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/TextAppearance.Mood.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="start" android:text="@string/settings_backup_section"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonExport" style="@style/Widget.Mood.TonalButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:text="@string/settings_export" app:icon="@drawable/ic_export" app:iconGravity="textStart"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonImport" style="@style/Widget.Mood.TonalButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="5dp" android:layout_weight="1" android:text="@string/settings_import" app:icon="@drawable/ic_import" app:iconGravity="textStart"/>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Mood.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/TextAppearance.Mood.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:text="@string/mood_brand_title"/>
                <TextView style="@style/TextAppearance.Mood.CardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="start" android:text="@string/mood_about_description"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
