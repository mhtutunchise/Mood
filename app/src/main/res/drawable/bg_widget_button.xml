<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_button_pressed" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/mood_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_button_background" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/widget_button_outline" />
        </shape>
    </item>
</selector>
